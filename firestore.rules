rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function owner() { return signedIn() && userDoc().role == 'owner'; }
    function staff() { return owner() || (signedIn() && userDoc().role in ['manager', 'editor']); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || owner());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'customer';
      allow update: if owner() || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if owner();
    }
    match /products/{id} { allow read: if signedIn(); allow write: if staff(); }
    match /orders/{id} { allow read: if staff() || (signedIn() && resource.data.userId == request.auth.uid); allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update: if staff() || (signedIn() && resource.data.userId == request.auth.uid); }
    match /reviews/{id} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update, delete: if staff() || (signedIn() && resource.data.userId == request.auth.uid); }
    match /{document=**} { allow read, write: if false; }
  }
}
